#!/bin/zsh

echo "metti l'operaione: "
read ope

if [[ ! $ope =~ ^[0-9]+[-+*/][0-9]+$ ]]; then
    echo "Operazione non valida"
    exit 1
fi

if [[ ${ope: -2} == "/0" ]]; then
   echo "errore non puoi fare diviso 0"
   exit 1
fi

numeri=""
operatore=""
for (( i=0; i<${#ope}; i++ )); do
    if [[ ${ope:$i:1} == [0-9] ]]; then
        numeri="${numeri}${ope:$i:1}"
    else
        operatore="${ope:$i:1}"
    fi
done

val1=""
for (( i=0; i<${#ope}; i++ )); do
    if [[ ${ope:$i:1} == [0-9] ]]; then
        val1="${val1}${ope:$i:1}"
    else
        break
    fi
done

val2=""
for (( i=${#ope}-1; i>=0; i-- )); do
    if [[ ${ope:$i:1} == [0-9] ]]; then
        val2="${ope:$i:1}${val2}"
    else
        break
    fi
done

if [[ $operatore == "+" ]]; then
    ris=$((val1 + val2))
elif [[ $operatore == "-" ]]; then
    ris=$((val1 - val2))
elif [[ $operatore == "*" ]]; then
    ris=$((val1 * val2))
elif [[ $operatore == "/" ]]; then
    ris=$((val1 / val2))
else
    echo "opzione non valida"
    exit 1
fi

echo -n "$ris"

while true; do 
    read ope2
    
    if [[ ! $ope2 =~ ^[-+*/][0-9]+$ ]]; then
        echo "Operazione non valida"
        exit 1
    fi

    if [[ ${ope2: -2} == "/0" ]]; then
        echo "errore non puoi fare diviso 0"
        exit 1
    fi

    operatore2="${ope2:0:1}"

    val2=""
    for (( i=${#ope2}-1; i>=0; i-- )); do
        if [[ ${ope2:$i:1} == [0-9] ]]; then
            val2="${ope2:$i:1}${val2}"
        else
            break
        fi
    done

    if [[ $operatore2 == "+" ]]; then
        ris2=$((ris + val2))
    elif [[ $operatore2 == "-" ]]; then
        ris2=$((ris - val2))
    elif [[ $operatore2 == "*" ]]; then
        ris2=$((ris * val2))
    elif [[ $operatore2 == "/" ]]; then
        ris2=$((ris / val2))
    else
        echo "opzione non valida"
        exit 1
    fi
    echo -n "$ris2"
    ris=$ris2
done
